---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  minutes?: number;
  /** Section the entry belongs to, linked from the rail. */
  section: { label: string; href: string };
  /** Optional extra rail line, e.g. a topic. */
  aside?: { label: string; href?: string };
  tags?: string[];
  transitionName?: string;
}

const { title, description, date, updated, minutes, section, aside, tags = [], transitionName } =
  Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="article wrap">
    <aside class="rail" aria-label="About this entry">
      <a href={section.href}>{section.label}</a>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {
        updated && (
          <span>
            Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
          </span>
        )
      }
      {minutes ? <span>{minutes} min read</span> : null}
      {aside && (aside.href ? <a href={aside.href}>{aside.label}</a> : <span>{aside.label}</span>)}
    </aside>

    <div class="column">
      <header>
        <h1 transition:name={transitionName}>{title}</h1>
        <p class="lede">{description}</p>
      </header>
      <slot name="before" />
      <div class="prose">
        <slot />
      </div>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    position: sticky;
    top: var(--space-4);
    align-self: start;
    padding-block-start: 0.6rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .rail a {
    color: var(--text);
  }

  .column {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }

  .lede {
    margin-block: var(--space-3) var(--space-5);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .tags li {
    padding: 0.15em 0.6em;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  @media (max-width: 48rem) {
    .article {
      grid-template-columns: 1fr;
      padding-block-start: var(--space-5);
    }

    .rail {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-3);
      padding-block-start: 0;
    }

    h1 {
      font-size: var(--step-4);
    }
  }
</style>

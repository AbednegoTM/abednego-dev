---
/**
 * Build-time contour field: stacked lines displaced by layered sine "terrain".
 * Static stand-in for the WebGL hero and its reduced-motion fallback.
 * One line (the road) is drawn in the accent colour.
 */
const width = 1600;
const height = 900;
const lineCount = 22;
const roadIndex = 5; // matches the shader's road level, above the name
const samples = 120;

function terrain(x: number, y: number) {
  return (
    Math.sin(x * 0.0042 + y * 0.003) * 38 +
    Math.sin(x * 0.011 - y * 0.006 + 1.7) * 16 +
    Math.cos(x * 0.0021 + 0.8) * Math.sin(y * 0.0055) * 46
  );
}

const lines = Array.from({ length: lineCount }, (_, i) => {
  const baseY = ((i + 1) / (lineCount + 1)) * height;
  const points = Array.from({ length: samples + 1 }, (_, s) => {
    const x = (s / samples) * width;
    return [x, baseY + terrain(x, baseY)] as const;
  });
  const d = points
    .map(([x, y], idx) => `${idx === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`)
    .join(' ');
  return { d, road: i === roadIndex };
});
---

<svg
  class="contours"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  {lines.map(({ d, road }) => <path d={d} class:list={{ road }} />)}
</svg>

<style>
  .contours {
    width: 100%;
    height: 100%;
  }

  path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.7;
  }

  path.road {
    stroke: var(--accent);
    stroke-width: 2;
    opacity: 1;
  }
</style>

---
import ContourStatic from './ContourStatic.astro';
---

<section class="hero" data-hero>
  <div class="field" aria-hidden="true">
    <div class="static"><ContourStatic /></div>
    <canvas data-hero-canvas></canvas>
  </div>
  <div class="hero-copy wrap">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(78dvh, 52rem);
    overflow: hidden;
  }

  .field {
    /* Let the field dissolve into the page instead of ending on hard edges */
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 78%, transparent);
  }

  .field,
  .static,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  canvas {
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }

  .static {
    transition: opacity 1200ms var(--ease-out);
  }

  .hero.is-live canvas {
    opacity: 1;
  }

  .hero.is-live .static {
    opacity: 0;
  }

  .hero-copy {
    position: relative;
    padding-block: var(--space-6);
    pointer-events: none;
  }

  .hero-copy :global(a) {
    pointer-events: auto;
  }
</style>

<script>
  import { onPage, prefersReducedMotion } from '../animations/lifecycle';

  onPage(async () => {
    const host = document.querySelector<HTMLElement>('[data-hero]');
    const canvas = host?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!host || !canvas || prefersReducedMotion()) return;

    const { ContourField } = await import('../hero/ContourField');

    let field: InstanceType<typeof ContourField> | undefined;
    try {
      field = new ContourField(
        canvas,
        host,
        () => host.classList.add('is-live'),
        () => host.classList.remove('is-live'),
      );
    } catch {
      return; // No WebGL2: the static field stays.
    }
    field.begin();

    const stop = () => {
      field?.dispose();
      field = undefined;
      host.classList.remove('is-live');
    };

    // Turning on reduced motion mid-visit drops back to the static field
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const onMotionChange = () => motion.matches && stop();
    motion.addEventListener('change', onMotionChange);

    return () => {
      motion.removeEventListener('change', onMotionChange);
      stop();
    };
  });
</script>

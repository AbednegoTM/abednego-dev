---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/writing', label: 'Writing' },
  { href: '/notes', label: 'Notes' },
  { href: '/projects', label: 'Projects' },
  { href: '/lab', label: 'Lab' },
  { href: '/bookmarks', label: 'Bookmarks' },
  { href: '/about', label: 'About' },
];

// Footer links, repeated at the foot of the mobile menu
const extraLinks = [
  { href: '/now', label: 'Now' },
  { href: '/uses', label: 'Uses' },
  { href: '/rss.xml', label: 'RSS' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header wrap" transition:name="site-header" data-site-header>
  <a class="home" href="/" aria-label="Abednego Mwanza, home">Abednego</a>
  <nav class="menu" id="site-menu" aria-label="Main">
    <div class="menu-inner">
      <ul class="primary">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="extra">
        {
          extraLinks.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
  <ThemeToggle />
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-toggle
  >
    <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    <span data-menu-label>Menu</span>
  </button>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .home {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .menu {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .extra {
    display: none;
  }

  .menu a {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .menu a:hover,
  .menu a[aria-current='page'] {
    color: var(--text);
  }

  .menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: var(--text);
  }

  /* Two contour-like strokes that cross into an ✕ when open */
  .menu-icon {
    position: relative;
    inline-size: 1rem;
    block-size: 0.75rem;
  }

  .menu-icon span {
    position: absolute;
    inset-inline: 0;
    block-size: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition:
      translate 240ms var(--ease-out),
      rotate 240ms var(--ease-out);
  }

  .menu-icon span:first-child {
    top: 0.125rem;
  }

  .menu-icon span:last-child {
    bottom: 0.125rem;
  }

  .site-header[data-open] .menu-icon span:first-child {
    translate: 0 0.19rem;
    rotate: 45deg;
  }

  .site-header[data-open] .menu-icon span:last-child {
    translate: 0 -0.19rem;
    rotate: -45deg;
  }

  @media (max-width: 48rem) {
    .site-header {
      flex-wrap: wrap;
      row-gap: var(--space-2);
    }

    :global(.theme-toggle) {
      margin-inline-start: auto;
    }

    .menu {
      order: 3;
      flex-basis: 100%;
      margin-inline-start: 0;
    }

    /* Without JS the links show as a plain stacked list */
    .primary {
      flex-direction: column;
      gap: 0;
    }

    .primary a {
      display: block;
      padding-block: var(--space-3);
      border-block-start: 1px solid var(--line);
      font-size: var(--step-2);
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .primary a[aria-current='page'] {
      text-decoration-thickness: 3px;
    }

    .extra {
      display: flex;
      gap: var(--space-4);
      padding-block: var(--space-3) var(--space-2);
      border-block-start: 1px solid var(--line);
    }

    .extra a {
      display: inline-block;
      padding-block: var(--space-2);
    }

    /* With JS: a collapsible panel under the header */
    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .menu {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows 280ms var(--ease-out),
        visibility 0s linear 280ms;
    }

    :global(.js) .site-header[data-open] .menu {
      grid-template-rows: 1fr;
      visibility: visible;
      transition:
        grid-template-rows 280ms var(--ease-out),
        visibility 0s;
    }

    .menu-inner {
      min-block-size: 0;
      overflow: hidden;
    }
  }
</style>

<script>
  import { onPage } from '../animations/lifecycle';

  onPage(() => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const button = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const label = button?.querySelector<HTMLElement>('[data-menu-label]');
    if (!header || !button || !label) return;

    const mobile = matchMedia('(max-width: 48rem)');
    const isOpen = () => header.hasAttribute('data-open');

    const setOpen = (open: boolean, { focusButton = false } = {}) => {
      header.toggleAttribute('data-open', open);
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
      if (open) header.querySelector<HTMLAnchorElement>('.primary a')?.focus();
      else if (focusButton) button.focus();
    };

    const onToggle = () => setOpen(!isOpen());
    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false, { focusButton: true });
    };
    const onPointerDown = (event: PointerEvent) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    };
    // A link to the page you're on doesn't navigate, so close the panel explicitly
    const onLinkClick = (event: MouseEvent) => {
      if ((event.target as Element).closest('.menu a')) setOpen(false);
    };
    const onBreakpoint = () => !mobile.matches && setOpen(false);

    button.addEventListener('click', onToggle);
    header.addEventListener('click', onLinkClick);
    document.addEventListener('keydown', onKeydown);
    document.addEventListener('pointerdown', onPointerDown);
    mobile.addEventListener('change', onBreakpoint);

    return () => {
      button.removeEventListener('click', onToggle);
      header.removeEventListener('click', onLinkClick);
      document.removeEventListener('keydown', onKeydown);
      document.removeEventListener('pointerdown', onPointerDown);
      mobile.removeEventListener('change', onBreakpoint);
    };
  });
</script>

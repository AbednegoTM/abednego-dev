---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getPublished } from '../../lib/content';

const projects = (await getPublished('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const intro = 'Things I have designed and built, and what I learned along the way.';
---

<BaseLayout title="Projects" description={intro}>
  <div class="wrap">
    <PageHeader title="Projects" intro={intro} />
    {
      projects.length === 0 ? (
        <EmptyState>No case studies published yet.</EmptyState>
      ) : (
        <ul class="projects" role="list">
          {projects.map((project) => (
            <ProjectRow project={project} />
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .projects {
    list-style: none;
    padding: 0;
    border-block-end: 1px solid var(--line);
  }
</style>
